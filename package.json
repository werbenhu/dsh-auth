{
  "name": "dsh-auth",
  "version": "0.1.0",
  "description": "Login, logout, account settings (Settings → Login & Security) and a restart button for the DeepSeek Harness (dsh) web UI",
  "homepage": "https://github.com/werbenhu/dsh-auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/werbenhu/dsh-auth.git"
  },
  "bugs": {
    "url": "https://github.com/werbenhu/dsh-auth/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "authentication",
    "login"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "bin": {
    "dsh-auth-reset": "bin/dsh-auth-reset.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "license": "MIT",
  "files": [
    "lib",
    "bin",
    "src",
    "cordis.patch.yml",
    "build.mjs",
    "README.md",
    "README.zh-CN.md"
  ]
}
